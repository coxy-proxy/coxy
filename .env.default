# Gateway
# API Gateway configuration
PORT=3000
BACKEND_HOST=localhost
BACKEND_PORT=3020
FRONTEND_HOST=localhost
FRONTEND_PORT=3010

# DB
DATABASE_URL=file:../coxy.db

# JWT defaults (override in .env)
# JWT_SECRET is used as fallback if ACCESS/REFRESH are not set
# TTL supports s|m|h|d units; recommended: 15m access, 7d refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
