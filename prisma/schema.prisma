generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Phase 1: Auth-ready schema (backward compatible)

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  apiKeys       ApiKey[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id         String       @id @default(uuid())
  name       String
  key        String       @unique
  createdAt  DateTime     @default(now())
  lastUsed   DateTime?
  usageCount Int          @default(0)
  isDefault  Boolean      @default(false)
  meta       CopilotMeta?

  // Optional owner for backward compatibility (global keys have userId = null)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isDefault])
  @@index([userId])
}

model CopilotMeta {
  id               String   @id @default(uuid())
  token            String
  expiresAt        DateTime
  resetTime        DateTime?
  chatQuota        Int?
  completionsQuota Int?
  apiKeyId         String   @unique
  apiKey           ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
}
